# Version pins for everything that makes up the desktop (Electron) shell.
# Sourced by build-exe.yml, build-appimage.yml and build-macos.yml instead of
# hardcoding versions inline, and hashed by scripts/compute-native-
# fingerprint.js (desktop) - so bumping any of these changes the desktop
# shell fingerprint, and the release is delivered as a full application
# update rather than a content-only one. Same idea as
# configs/capacitor-versions.env for the mobile builds.
ELECTRON_VERSION=43.0.0
ELECTRON_BUILDER_VERSION=26.15.3
# Required at runtime by discord-rpc.cjs.
DISCORD_RPC_VERSION=1.5.1
# Required at runtime by ota-desktop.cjs to unzip content updates.
YAUZL_VERSION=3.4.0
