# Single source of truth for Capacitor/plugin version pins. Sourced by both
# build-android.yml and build-ios.yml instead of hardcoding versions inline,
# so a version bump here automatically changes scripts/compute-native-
# fingerprint.js's output for both platforms - there's no separate "remember
# to bump the fingerprint too" step.
CAPACITOR_CORE_VERSION=8.4.1
CAPACITOR_CLI_VERSION=8.4.1
CAPACITOR_ANDROID_VERSION=8.4.1
CAPACITOR_IOS_VERSION=8.4.1
CAPACITOR_FILESYSTEM_VERSION=8.1.2
CAPACITOR_SHARE_VERSION=8.0.1
CAPACITOR_STATUSBAR_VERSION=8.0.2
CAPACITOR_APP_VERSION=8.1.1
CAPACITOR_BROWSER_VERSION=8.0.4
CAPACITOR_SOCIAL_LOGIN_VERSION=8.3.33
# Client-side unzip for the mobile OTA updater (new-files/src/system/offline/mobile-updater.ts).
CAPACITOR_FFLATE_VERSION=0.8.2
# Saves screenshots to a custom photo album (new-files/src/system/offline/screenshot-saver.ts).
CAPACITOR_COMMUNITY_MEDIA_VERSION=9.1.0
# Downloads the OTA web bundle/APK natively in mobile-updater.ts - the WebView's
# own fetch() can't follow a GitHub release asset's redirect to its signed
# storage URL (no CORS header there permitting the app's capacitor:// origin).
CAPACITOR_FILE_TRANSFER_VERSION=2.0.6
